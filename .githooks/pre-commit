#!/usr/bin/env bash
# Pre-commit hook: one fast source check, nothing heavy.
#
# When a commit touches TypeScript under packages/*/src/, this runs
# credential-scope:check (~0.7 s, no build): a credential the platform stores
# must be classified, or no surface can route it. Build, typecheck, tests and
# the release checks run in CI (see docs/testing-and-validation.md); generated
# files are refreshed by `bun run release:prepare` at the version bump.
#
# Activated by `git config core.hooksPath .githooks` (the `prepare` script in
# package.json runs it after `bun install`).
#
# Bypass in an emergency: `git commit --no-verify`.
set -euo pipefail

STAGED_SRC=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^packages/[^/]+/src/.*\.ts$' || true)
if [ -z "$STAGED_SRC" ]; then
  exit 0
fi

if ! bun run credential-scope:check; then
  echo "" >&2
  echo "[pre-commit] BLOCKED: credential-scope-check failed (see above)." >&2
  echo "  A credential nothing classifies is a credential nothing can route." >&2
  echo "  Bypass (emergency only): git commit --no-verify" >&2
  exit 1
fi

exit 0
