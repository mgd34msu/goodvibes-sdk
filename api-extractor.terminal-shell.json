{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "extends": "./api-extractor.json",
  "mainEntryPointFilePath": "<projectFolder>/packages/terminal-shell/dist/index.d.ts",
  "bundledPackages": [],
  "compiler": {
    "tsconfigFilePath": "<projectFolder>/packages/terminal-shell/tsconfig.api-extractor.json",
    "overrideTsconfig": {
      "compilerOptions": {
        "paths": {}
      }
    }
  },
  "apiReport": {
    "enabled": true,
    "reportFileName": "goodvibes-terminal-shell.api.md",
    "reportFolder": "<projectFolder>/etc/",
    "reportTempFolder": "<projectFolder>/temp/"
  }
}
